{
  "name": "prisma-postgrejs",
  "description": "Prisma driver adapter for PostgreJS - run a Prisma schema on PostgreJS's wire-protocol client",
  "version": "1.0.3",
  "author": "Panates",
  "license": "BSD-3-Clause",
  "private": true,
  "peerDependencies": {
    "@prisma/driver-adapter-utils": ">=7.10.0 <9",
    "postgrejs": ">=3.11.0 <4"
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.1.6",
    "@panates/eslint-config-ts": "^2.1.6",
    "@panates/tsconfig": "^2.1.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/driver-adapter-utils": "^7.10.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "auto-changelog": "^2.6.0",
    "c8": "^12.0.0",
    "dpdm": "^4.2.0",
    "expect": "^30.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.1",
    "pg": "^8.23.0",
    "postgrejs": "^3.11.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "ts-cleanup": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "compile": "tsc -b tsconfig-build.json --noEmit",
    "clean": "npm run clean:src && npm run clean:dist",
    "clean:dist": "rimraf build coverage",
    "clean:src": "ts-cleanup -s src --all | ts-cleanup -s test",
    "prebuild": "npm run check && npm run clean:dist && npm run lint",
    "build": "tsc -b tsconfig-build.json",
    "postbuild": "node postbuild.cjs && rimraf build/*.tsbuildinfo",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier . --write --log-level=warn",
    "check": "dpdm -T --no-warning --no-tree ./src/index.ts",
    "test": "mocha",
    "test:prisma-suite": "bash scripts/run-prisma-suite.sh",
    "precitest": "rimraf coverage",
    "citest": "c8 mocha",
    "qc": "npm run lint && npm run check",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "prepare": "husky || true"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0"
  },
  "homepage": "https://www.postgrejs.com/",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panates/postgrejs-prisma.git"
  },
  "keywords": [
    "prisma",
    "prisma-adapter",
    "driver-adapter",
    "postgrejs",
    "postgresql",
    "postgres",
    "sql",
    "orm",
    "typescript",
    "wire-protocol",
    "no-native-bindings"
  ],
  "publishConfig": {
    "access": "public"
  }
}
