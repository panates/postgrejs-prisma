{
  "name": "prisma-postgrejs",
  "description": "Prisma driver adapter for PostgreJS - run a Prisma schema on PostgreJS's wire-protocol client",
  "version": "1.1.0",
  "author": "Panates",
  "license": "MIT",
  "private": true,
  "peerDependencies": {
    "@prisma/driver-adapter-utils": ">=7.10.0 <9",
    "postgrejs": ">=3.12.1 <4"
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.2.0",
    "@panates/eslint-config-ts": "^2.2.1",
    "@panates/rman-preset": "^1.8.3",
    "@panates/tsconfig": "^2.1.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/driver-adapter-utils": "^7.10.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "dpdm": "^4.3.0",
    "expect": "^30.5.2",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "pg": "^8.23.1",
    "postgrejs": "^3.13.0",
    "prisma": "^7.10.0"
  },
  "scripts": {
    "test": "mocha",
    "test:prisma-suite": "bash scripts/run-prisma-suite.sh",
    "bench": "node benchmark/bench.mjs",
    "bench:report": "node benchmark/render-report.mjs",
    "precitest": "rman clean",
    "citest": "c8 mocha"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0"
  },
  "homepage": "https://www.postgrejs.com/",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panates/postgrejs-prisma.git"
  },
  "keywords": [
    "prisma",
    "prisma-adapter",
    "driver-adapter",
    "postgrejs",
    "postgresql",
    "postgres",
    "sql",
    "orm",
    "typescript",
    "wire-protocol",
    "no-native-bindings"
  ],
  "publishConfig": {
    "access": "public"
  }
}
